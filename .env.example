# ──────────────────────────────────────────────────────────────
# DirecioZAP — Exemplo de configuracao
# Copie para .env e preencha com suas credenciais
# NUNCA commite o arquivo .env
# ──────────────────────────────────────────────────────────────

# Provedor WhatsApp: twilio | meta
PROVIDER=twilio

# ── Twilio ───────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=+14155238886
# URL publica configurada no Twilio em "When a message comes in". Opcional:
# quando vazia, e reconstruida dos headers X-Forwarded-* do ngrok/Render.
# Precisa bater exatamente com a URL do console, pois e ela que o Twilio assina.
TWILIO_WEBHOOK_URL=

# ── Meta WhatsApp Cloud API ───────────────────────────────────
META_PHONE_NUMBER_ID=000000000000000
META_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Token de seguranca para /exportar ────────────────────────
VERIFY_TOKEN=troque_por_token_seguro_aleatorio

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=sua_supabase_anon_key_aqui

# ── ngrok ─────────────────────────────────────────────────────
NGROK_AUTH_TOKEN=seu_ngrok_auth_token_aqui
NGROK_DOMAIN=

# ── Saida Excel ───────────────────────────────────────────────
EXCEL_PATH=./data/fornecedores.xlsx
